        <footer>
            <span>ARCHIE LUMOSAD © 2026</span>
            <a href="#top">BACK TO TOP ↑</a>
        </footer>

    </div>
</section>

</main>

<!-- LIGHTBOX / PROJECT GALLERY -->

<div class="lightbox" id="lightbox">

    <button class="lightbox-close" aria-label="Close project viewer">×</button>

    <div class="lightbox-content">
        <img src="" alt="Project preview">
    </div>

    <div class="lightbox-caption"></div>

</div>

